# Impede acesso direto a configuração, código-fonte, dados e testes.
Options -Indexes

<FilesMatch "^(config(\.exemplo)?\.php|cli\.php|.*\.(md|txt|db|sqlite))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(src|dados|tests|\.git)(/|$) - [F,L]
</IfModule>
